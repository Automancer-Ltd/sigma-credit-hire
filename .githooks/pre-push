#!/usr/bin/env bash
set -euo pipefail
# naz-hardening pre-push
red='\033[0;31m'; green='\033[0;32m'; yellow='\033[1;33m'; nc='\033[0m'
if command -v gitleaks >/dev/null 2>&1; then
  gitleaks git --redact --config .gitleaks.toml --no-banner --log-opts=HEAD >/dev/null 2>&1 || { echo -e "${red}✗ Push blocked:${nc} gitleaks found potential secrets in history."; exit 1; }
else
  echo -e "${yellow}! gitleaks not installed; running basic fallback scan.${nc}"
  suspect=$(git ls-files | grep -Ei '(\.env$|\.pem$|\.key$|token|secret|credential|openclaw\.json$)' || true)
  [[ -n "$suspect" ]] && { echo -e "${red}✗ Push blocked:${nc} suspicious tracked filenames detected:"; echo "$suspect"; exit 1; }
fi
echo -e "${green}✓ pre-push checks passed${nc}"
